<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Agronom — Ro‘yxatdan o‘tish</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #e9f7ed, #f8fcf8);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.container {
    width: 100%;
    max-width: 440px;
    background: white;
    padding: 38px;
    border-radius: 24px;
    box-shadow: 0 15px 50px rgba(30, 90, 50, 0.10);
}

.logo {
    text-align: center;
    margin-bottom: 30px;
}

.logo-icon {
    font-size: 48px;
}

.logo h1 {
    color: #267747;
    font-size: 27px;
    margin-top: 8px;
}

.logo p {
    color: #829287;
    font-size: 13px;
    margin-top: 7px;
}

h2 {
    color: #183d29;
    font-size: 25px;
    margin-bottom: 10px;
}

.description {
    color: #829287;
    font-size: 14px;
    line-height: 1.5;
    margin-bottom: 27px;
}

label {
    display: block;
    font-size: 13px;
    font-weight: bold;
    color: #345a40;
    margin-bottom: 9px;
}

input {
    width: 100%;
    padding: 15px;
    border: 1px solid #dce9df;
    border-radius: 11px;
    outline: none;
    font-size: 15px;
    margin-bottom: 19px;
}

input:focus {
    border-color: #31965a;
    box-shadow: 0 0 0 3px #31965a18;
}

button {
    width: 100%;
    padding: 15px;
    border: none;
    border-radius: 11px;
    cursor: pointer;
    font-size: 15px;
    font-weight: bold;
}

.primary {
    background: #27804a;
    color: white;
    margin-bottom: 18px;
}

.primary:hover {
    background: #1d683b;
}

.divider {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #a0ada3;
    font-size: 12px;
    margin: 8px 0 18px;
}

.divider::before,
.divider::after {
    content: "";
    height: 1px;
    background: #e5ece6;
    flex: 1;
}

.google {
    background: white;
    color: #35463a;
    border: 1px solid #dce9df;
}

.google:hover {
    background: #f6faf6;
}

.login {
    text-align: center;
    font-size: 13px;
    color: #849187;
    margin-top: 25px;
}

.login a {
    color: #27804a;
    font-weight: bold;
    text-decoration: none;
}

.terms {
    text-align: center;
    font-size: 11px;
    color: #9aa79d;
    margin-top: 22px;
    line-height: 1.6;
}

@media(max-width: 480px) {
    .container {
        padding: 27px 22px;
    }
}
</style>
</head>

<body>

<div class="container">

    <div class="logo">
        <div class="logo-icon">🌱</div>
        <h1>AI Agronom</h1>
        <p>Aqlli dehqonchilik platformasi</p>
    </div>

    <h2>Akkaunt yarating</h2>

    <p class="description">
        AI Agronom imkoniyatlaridan foydalanish uchun
        ro‘yxatdan o‘ting.
    </p>

    <label>Telefon raqamingiz</label>

    <input
        type="tel"
        id="phone"
        placeholder="+998 90 123 45 67"
    >

    <button class="primary" onclick="registerPhone()">
        Davom etish →
    </button>

    <div class="divider">YOKI</div>

    <button class="google" onclick="registerGoogle()">
        🌐 Google orqali davom etish
    </button>

    <div class="login">

